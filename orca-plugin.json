{
  "manifestVersion": 1,
  "id": "xjb-coding",
  "publisher": "0xdevelop",
  "name": "xjb_coding",
  "version": "0.0.31",
  "description": "安装 xjb_coding Skills，并提供填写读取提示的命令。所有 agent 沿用现有 Skill 规则；MCP 使用 agent 已有配置。",
  "author": { "name": "0xdevelop" },
  "repository": "https://github.com/0xdevelop/xjb_coding",
  "engines": { "orca": ">=1.4.224" },
  "pluginApi": 1,
  "main": "orca/main.mjs",
  "contributes": {
    "commands": [
      {
        "id": "xjb-coding.load",
        "title": "xjb_coding：填入 Skills 读取提示",
        "context": "worktree"
      }
    ]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "terminal:send" }
  ]
}
